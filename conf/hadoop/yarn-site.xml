<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  Memory budget for this VM (total RAM 3.8 GB):
    OS + resident services (VS Code server)                   ~ 1.7 GB
    HDFS/YARN daemon heaps (see hadoop-env.sh)                ~ 1.3 GB max
    YARN container pool (below)                                 2560 MB
  Grafana and InfluxDB were removed from this VM on 2026-11-04, freeing
  ~288 MB of resident memory; the pool was raised from 2048 to 2560 MB to
  claim it. The pool still deliberately overlaps swap (3.8 GB) because
  MapReduce containers are short-lived; pmem checking stays on to bound them.
-->
<configuration>
  <property>
    <name>yarn.resourcemanager.hostname</name>
    <value>localhost</value>
  </property>
  <property>
    <name>yarn.nodemanager.aux-services</name>
    <value>mapreduce_shuffle</value>
  </property>
  <property>
    <name>yarn.nodemanager.resource.memory-mb</name>
    <value>2560</value>
  </property>
  <property>
    <name>yarn.nodemanager.resource.cpu-vcores</name>
    <value>4</value>
    <description>6 vCPUs present; 2 left for the OS and the HDFS daemons.</description>
  </property>
  <property>
    <name>yarn.scheduler.minimum-allocation-mb</name>
    <value>512</value>
  </property>
  <property>
    <name>yarn.scheduler.maximum-allocation-mb</name>
    <value>1024</value>
  </property>
  <property>
    <name>yarn.scheduler.maximum-allocation-vcores</name>
    <value>4</value>
  </property>
  <property>
    <name>yarn.nodemanager.vmem-check-enabled</name>
    <value>false</value>
    <description>
      The JVM reserves a large virtual address space on aarch64; the default
      2.1x vmem ratio kills otherwise healthy containers. Physical memory is
      still enforced via pmem-check below.
    </description>
  </property>
  <property>
    <name>yarn.nodemanager.pmem-check-enabled</name>
    <value>true</value>
  </property>
  <property>
    <name>yarn.nodemanager.local-dirs</name>
    <value>${user.home}/project/hadoop-data/yarn/local</value>
  </property>
  <property>
    <name>yarn.nodemanager.log-dirs</name>
    <value>${user.home}/project/hadoop-data/yarn/logs</value>
  </property>
  <property>
    <name>yarn.log-aggregation-enable</name>
    <value>true</value>
  </property>
  <property>
    <name>yarn.nodemanager.delete.debug-delay-sec</name>
    <value>600</value>
  </property>
</configuration>
